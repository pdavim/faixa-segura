rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 4.1: Global Safety Net (Default-Deny Catch-All)
    match /{document=**} {
      allow read, write: if false;
    }

    // Phase 3: Reusable Hardened Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    // Pillar 1 & 7: Master Gate + Atomic Registration Batch Support
    function hasUserAnchor(userId) {
      return exists(/databases/$(database)/documents/users/$(userId))
        || existsAfter(/databases/$(database)/documents/users/$(userId));
    }

    // Pillar 2: Validation Blueprints (Verbatim synced with firebase-blueprint.json)
    function isValidUserPublicProfile(data) {
      return data.keys().hasAll(['uid', 'displayName', 'preferredDico', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'preferredDico', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$')
        && data.uid == request.auth.uid
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100
        && data.preferredDico is string && data.preferredDico.size() == 4 && data.preferredDico.matches('^[0-9]{4}$')
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserPrivateInfo(data) {
      return data.keys().hasAll(['uid', 'email', 'nif', 'phone', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'nif', 'phone', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$')
        && data.uid == request.auth.uid
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 160
        && data.nif is string && data.nif.size() <= 9
        && data.phone is string && data.phone.size() <= 24
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserHistoryEntry(data) {
      return data.keys().hasAll([
          'uid',
          'category',
          'title',
          'parcelId',
          'parcelLabel',
          'municipality',
          'referenceCode',
          'areaM2',
          'pirLevel',
          'soilMoisturePct',
          'summary',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'category',
          'title',
          'parcelId',
          'parcelLabel',
          'municipality',
          'referenceCode',
          'areaM2',
          'pirLevel',
          'soilMoisturePct',
          'summary',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$')
        && data.uid == request.auth.uid
        && data.category is string && data.category.size() >= 5 && data.category.size() <= 20
        && data.category in ['PARCEL', 'CERTIFICATE', 'QUOTE', 'NEIGHBOR', 'INTERVENTION']
        && data.title is string && data.title.size() >= 2 && data.title.size() <= 140
        && data.parcelId is string && data.parcelId.size() >= 1 && data.parcelId.size() <= 128 && data.parcelId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.parcelLabel is string && data.parcelLabel.size() >= 1 && data.parcelLabel.size() <= 120
        && data.municipality is string && data.municipality.size() >= 2 && data.municipality.size() <= 80
        && data.referenceCode is string && data.referenceCode.size() >= 1 && data.referenceCode.size() <= 64
        && data.areaM2 is number && data.areaM2 >= 0 && data.areaM2 <= 100000000
        && data.pirLevel is number && data.pirLevel >= 1 && data.pirLevel <= 5
        && data.soilMoisturePct is number && data.soilMoisturePct >= 0 && data.soilMoisturePct <= 100
        && data.summary is string && data.summary.size() >= 2 && data.summary.size() <= 500
        && data.status is string && data.status.size() >= 6 && data.status.size() <= 12
        && data.status in ['ACTIVE', 'ARCHIVED']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserSavedParcel(data) {
      return data.keys().hasAll([
          'uid',
          'parcelId',
          'label',
          'municipality',
          'dico',
          'matrixArticle',
          'bupiRggId',
          'landClass',
          'totalAreaM2',
          'mandatoryCleanAreaM2',
          'avgSlopePct',
          'hasEredesLine',
          'hasProtectedOaks',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'parcelId',
          'label',
          'district',
          'municipality',
          'dico',
          'parish',
          'matrixArticle',
          'bupiRggId',
          'landClass',
          'totalAreaM2',
          'mandatoryCleanAreaM2',
          'avgSlopePct',
          'hasEredesLine',
          'hasProtectedOaks',
          'userNotes',
          'createdAt',
          'updatedAt'
        ])
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$')
        && data.uid == request.auth.uid
        && data.parcelId is string && data.parcelId.size() >= 1 && data.parcelId.size() <= 128 && data.parcelId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.label is string && data.label.size() >= 2 && data.label.size() <= 120
        && (!('district' in data) || (data.district is string && data.district.size() >= 2 && data.district.size() <= 80))
        && data.municipality is string && data.municipality.size() >= 2 && data.municipality.size() <= 80
        && data.dico is string && data.dico.size() == 4 && data.dico.matches('^[0-9]{4}$')
        && (!('parish' in data) || (data.parish is string && data.parish.size() >= 1 && data.parish.size() <= 180))
        && data.matrixArticle is string && data.matrixArticle.size() >= 1 && data.matrixArticle.size() <= 80
        && data.bupiRggId is string && data.bupiRggId.size() >= 1 && data.bupiRggId.size() <= 40
        && data.landClass is string && data.landClass.size() >= 10 && data.landClass.size() <= 20
        && data.landClass in ['FOREST_SCRUB', 'AGRICULTURE', 'URBAN_BUILT']
        && data.totalAreaM2 is number && data.totalAreaM2 > 0 && data.totalAreaM2 <= 100000000
        && data.mandatoryCleanAreaM2 is number && data.mandatoryCleanAreaM2 >= 0 && data.mandatoryCleanAreaM2 <= 100000000
        && data.avgSlopePct is number && data.avgSlopePct >= 0 && data.avgSlopePct <= 100
        && data.hasEredesLine is bool
        && data.hasProtectedOaks is bool
        && (!('userNotes' in data) || (data.userNotes is string && data.userNotes.size() <= 2000))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // 1. Anchor Public Profile (/users/{userId}) - Non-PII
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;

      allow create: if isOwner(userId)
        && isValidId(userId)
        && isValidUserPublicProfile(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if (
        isSignedIn() && isValidUserPublicProfile(incoming()) && (
          isOwner(userId)
          && isValidId(userId)
          && incoming().uid == existing().uid
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'preferredDico', 'updatedAt'])
        )
      );

      allow delete: if false;

      // 2. PII Isolation Subcollection (/users/{userId}/private/{docId})
      match /private/{docId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(docId) && hasUserAnchor(userId);
        allow list: if false;

        allow create: if isOwner(userId)
          && isValidId(userId)
          && isValidId(docId)
          && docId == 'profile'
          && isValidUserPrivateInfo(incoming())
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && hasUserAnchor(userId);

        allow update: if (
          isSignedIn() && isValidUserPrivateInfo(incoming()) && (
            isOwner(userId)
            && isValidId(userId)
            && isValidId(docId)
            && docId == 'profile'
            && incoming().uid == existing().uid
            && incoming().createdAt == existing().createdAt
            && incoming().updatedAt == request.time
            && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'nif', 'phone', 'updatedAt'])
            && hasUserAnchor(userId)
          )
        );

        allow delete: if false;
      }

      // 3. Consultable User History Timeline (/users/{userId}/history/{entryId})
      match /history/{entryId} {
        allow get: if isOwner(userId)
          && isValidId(userId)
          && isValidId(entryId)
          && (resource == null || existing().uid == request.auth.uid)
          && hasUserAnchor(userId);

        // Pillar 8: Query Enforcer (Evaluates resource.data.uid with zero get/exists calls)
        allow list: if isOwner(userId)
          && resource.data.uid == request.auth.uid;

        allow create: if isOwner(userId)
          && isValidId(userId)
          && isValidId(entryId)
          && isValidUserHistoryEntry(incoming())
          && incoming().status == 'ACTIVE'
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && hasUserAnchor(userId);

        allow update: if (
          isSignedIn() && isValidUserHistoryEntry(incoming()) && (
            isOwner(userId)
            && isValidId(userId)
            && isValidId(entryId)
            && existing().status != 'ARCHIVED'
            && incoming().uid == existing().uid
            && incoming().category == existing().category
            && incoming().parcelId == existing().parcelId
            && incoming().referenceCode == existing().referenceCode
            && incoming().createdAt == existing().createdAt
            && incoming().updatedAt == request.time
            && (
              // Action: ArchiveEntry
              (incoming().status == 'ARCHIVED'
                && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']))
              ||
              // Action: EditInterventionNotes
              (incoming().status == existing().status
                && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'summary', 'updatedAt']))
            )
            && hasUserAnchor(userId)
          )
        );

        allow delete: if isOwner(userId)
          && isValidId(userId)
          && isValidId(entryId)
          && resource != null
          && existing().uid == request.auth.uid
          && hasUserAnchor(userId);
      }

      // 4. User Saved Parcels (/users/{userId}/parcels/{parcelId})
      match /parcels/{parcelId} {
        allow get: if isOwner(userId)
          && isValidId(userId)
          && isValidId(parcelId)
          && (resource == null || existing().uid == request.auth.uid)
          && hasUserAnchor(userId);

        allow list: if isOwner(userId)
          && resource.data.uid == request.auth.uid;

        allow create: if isOwner(userId)
          && isValidId(userId)
          && isValidId(parcelId)
          && incoming().parcelId == parcelId
          && isValidUserSavedParcel(incoming())
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && hasUserAnchor(userId);

        allow update: if (
          isSignedIn() && isValidUserSavedParcel(incoming()) && (
            isOwner(userId)
            && isValidId(userId)
            && isValidId(parcelId)
            && incoming().uid == existing().uid
            && incoming().parcelId == existing().parcelId
            && incoming().createdAt == existing().createdAt
            && incoming().updatedAt == request.time
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'label',
              'district',
              'municipality',
              'dico',
              'parish',
              'matrixArticle',
              'bupiRggId',
              'landClass',
              'totalAreaM2',
              'mandatoryCleanAreaM2',
              'avgSlopePct',
              'hasEredesLine',
              'hasProtectedOaks',
              'userNotes',
              'updatedAt'
            ])
            && hasUserAnchor(userId)
          )
        );

        allow delete: if isOwner(userId)
          && isValidId(userId)
          && isValidId(parcelId)
          && resource != null
          && existing().uid == request.auth.uid
          && hasUserAnchor(userId);
      }
    }
  }
}
