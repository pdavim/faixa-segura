# ==============================================================================
# FAIXASEGURA — CATÁLOGO COMPLETO DE VARIÁVEIS DE AMBIENTE (.env.example)
# Copie este ficheiro para `.env` em desenvolvimento local ou configure no Dokploy.
# Nota: Todas as chaves externas são OPCIONAIS no arranque — a aplicação possui
# contingência determinística/offline quando uma credencial não está definida.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVIDOR HTTP & AMBIENTE VITE
# ------------------------------------------------------------------------------
# URL público da aplicação (usado nos links de alertas Telegram/Email e QR Codes)
APP_URL="http://localhost:3000"
# Porta HTTP do servidor Express + Vite (manter 3000 em desenvolvimento / AI Studio)
PORT="3000"
# Definir "true" apenas em ambientes de proxy/iframe que bloqueiem WebSockets HMR
DISABLE_HMR="false"

# ------------------------------------------------------------------------------
# 2. PERSISTÊNCIA POSTGRESQL/POSTGIS & CACHE REDIS (Opcional — Fallback Memória)
# Como obter: Provisionado automaticamente via `docker-compose.yml` (serviços
# `faixasegura-db` e `faixasegura-redis`), ou crie uma instância gerida (Neon,
# Supabase, Railway, Upstash Redis) e cole os respetivos URIs de ligação.
# ------------------------------------------------------------------------------
POSTGRES_PASSWORD="faixasegura_local_2026"
DATABASE_URL="postgresql://faixasegura:faixasegura_local_2026@faixasegura-db:5432/faixasegura"
REDIS_URL="redis://faixasegura-redis:6379/0"

# ------------------------------------------------------------------------------
# 3. IA PRIVADA / OLLAMA (Extração Caderneta RGPD, Auditoria Fotos e Minutas)
# Como obter: Instale Ollama localmente (`https://ollama.com`, porta 11434) ou
# aponte para um servidor Ollama/OpenWebUI próprio. Se o endpoint exigir
# autenticação Bearer, gere um token no painel do seu gateway/OpenWebUI.
# ------------------------------------------------------------------------------
OLLAMA_BASE_URL="https://ollama.innovaive.com"
OLLAMA_API_KEY=""
OLLAMA_VISION_MODEL="gemma3:4b"
OLLAMA_TEXT_MODEL="qwen3:4b"
OLLAMA_TIMEOUT_MS="8500"

# ------------------------------------------------------------------------------
# 4. METEOROLOGIA IPMA & PROTEÇÃO CIVIL ANEPC (Dados Abertos — Sem Chave)
# Como obter: Endpoints públicos oficiais (`api.ipma.pt` e `apiaberta.pt`).
# Não requerem registo nem API key; altere apenas se usar um mirror próprio.
# ------------------------------------------------------------------------------
IPMA_RCM_BASE_URL="https://api.ipma.pt/open-data/forecast/meteorology/rcm"
ANEPC_API_ABERTA_URL="https://api.apiaberta.pt/v1/anpc/incidents/active"

# ------------------------------------------------------------------------------
# 5. SATÉLITE COPERNICUS SENTINEL-2 L2A (NDVI & Secura NDMI a 10 m)
# Como obter:
# 1) Crie conta gratuita em https://dataspace.copernicus.eu/
# 2) Aceda ao Dashboard Sentinel Hub -> User Settings -> OAuth clients -> Create
# 3) Copie o `Client ID` e `Client Secret` para as variáveis abaixo.
# Sem credenciais, o servidor usa o Catálogo Aberto (`COPERNICUS_CATALOG_URL`).
# ------------------------------------------------------------------------------
COPERNICUS_TOKEN_URL="https://identity.dataspace.copernicus.eu/auth/realms/CDSE/protocol/openid-connect/token"
COPERNICUS_STAC_URL="https://sh.dataspace.copernicus.eu/api/v1/process"
COPERNICUS_STATS_URL="https://sh.dataspace.copernicus.eu/api/v1/statistics"
COPERNICUS_CATALOG_URL="https://catalogue.dataspace.copernicus.eu/resto/api/collections/Sentinel2/search.json"
COPERNICUS_CLIENT_ID=""
COPERNICUS_CLIENT_SECRET=""

# ------------------------------------------------------------------------------
# 6. CADASTRO DGT / BUPi, REDE ELÉTRICA E-REDES, DECLIVE MDT & MOSAICOS DE MAPA
# Como obter:
# - `DGT_ORTHO_WMS_URL` / `DGT_CADASTRE_OGC_URL`: Serviços públicos OGC/WMS da
#   Direção-Geral do Território (`dgterritorio.gov.pt`, sem chave).
# - `EREDES_OPENDATA_API_KEY`: Opcional (aumenta limites de quota). Registe-se
#   gratuitamente em https://e-redes.opendatasoft.com -> Conta -> API Keys.
# - `ELEVATION_API_URL`: API pública Copernicus DEM (`open-meteo.com`, sem chave)
#   ou instância própria Open-Topo-Data.
# - `VITE_MAP_ORTHO_TILE_URL` / `VITE_MAP_VECTOR_TILE_URL`: Opcionais. Templates
#   XYZ/WMTS personalizados (`{z}/{x}/{y}`). Por omissão usa Esri `World_Imagery`
#   e `World_Topo_Map` (gratuitos, CORS ativo e sem marca de água).
# - `VITE_CARTO_API_KEY`: Opcional. Apenas necessária se pretender forçar os
#   mosaicos comerciais CARTO Positron em domínios cloud (obter em https://app.carto.com
#   -> Developers -> API Keys).
# ------------------------------------------------------------------------------
DGT_ORTHO_WMS_URL="https://cartografia.dgterritorio.gov.pt/ortos2021/service"
DGT_CADASTRE_OGC_URL="https://ogcapi.dgterritorio.gov.pt/collections/cadastro/items"
EREDES_OPENDATA_BASE_URL="https://e-redes.opendatasoft.com/api/explore/v2.1/catalog/datasets"
EREDES_OPENDATA_DATASET="rede-aerea-de-alta-e-media-tensao"
EREDES_OPENDATA_API_KEY=""
ELEVATION_API_URL="https://api.open-meteo.com/v1/elevation"
VITE_CARTO_API_KEY=""
VITE_MAP_ORTHO_TILE_URL=""
VITE_MAP_VECTOR_TILE_URL=""

# ------------------------------------------------------------------------------
# 7. MICROSERVIÇO EXTERNO DE VISÃO COMPUTACIONAL 25 CM (ONNX / YOLO / SegFormer)
# Como obter: Opcional. Por omissão, o pipeline espectral/OBIA corre localmente
# em Node. Para delegar num contentor GPU externo, indique o URL do endpoint e
# o token Bearer configurado nesse microserviço (`ORTHOPHOTO_CV_API_KEY`).
# ------------------------------------------------------------------------------
ORTHOPHOTO_CV_SERVICE_URL=""
ORTHOPHOTO_CV_API_KEY=""
ORTHOPHOTO_ONNX_PROFILE="yolo11s-seg+segformer-b2-dgt25cm"

# ------------------------------------------------------------------------------
# 8. FIREBASE AUTH & CLOUD FIRESTORE (Sincronização Multi-Dispositivo)
# Como obter: No AI Studio são lidas de `firebase-applet-config.json`. Para
# Docker/Dokploy externo: aceda a https://console.firebase.google.com ->
# Project Settings -> General -> Your apps (Web) e copie os valores `firebaseConfig`.
# ------------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_DATABASE_ID=""

# ------------------------------------------------------------------------------
# 9. ALERTAS EXTERNOS 24/7 — TELEGRAM, WEB PUSH (VAPID) & EMAIL (RESEND / SMTP)
# Como obter:
# - `TELEGRAM_BOT_TOKEN`: No Telegram, fale com `@BotFather` -> `/newbot`.
# - `TELEGRAM_DEFAULT_CHAT_ID`: Envie mensagem ao bot e consulte `@userinfobot`
#   ou `https://api.telegram.org/bot<TOKEN>/getUpdates`.
# - `VAPID_PUBLIC_KEY` / `VAPID_PRIVATE_KEY`: Gere um par de chaves executando:
#   `npx web-push generate-vapid-keys` (se vazias, gera chaves efémeras no arranque).
# - `RESEND_API_KEY`: Crie conta em https://resend.com/api-keys e gere uma chave
#   (ou indique `SMTP_WEBHOOK_URL` apontando para n8n / Make / bridge SMTP JSON).
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=""
TELEGRAM_DEFAULT_CHAT_ID=""
TELEGRAM_GUARDIAN_BOT_HANDLE="@FaixaSeguraBot"
TELEGRAM_PARTNERS_BOT_HANDLE="@FaixaSeguraParceirosBot"
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:alertas@faixasegura.pt"
RESEND_API_KEY=""
RESEND_FROM_EMAIL="FaixaSegura SGIFR <alertas@faixasegura.pt>"
SMTP_WEBHOOK_URL=""
